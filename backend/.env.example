# PhishGuard AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your organization.

PROJECT_NAME=PhishGuard AI
API_V1_STR=/api
SECRET_KEY=replace-with-a-random-secure-secret-key-32-chars-minimum

# Database (SQLite default for lightweight local deployment)
DATABASE_URL=sqlite:///./phishguard.db

# Max EML upload size in bytes (Default: 5 MB)
MAX_UPLOAD_SIZE_BYTES=5242880

# Triage Risk Score Thresholds (0-100)
# 0-24: Low Risk | 25-49: Moderate Risk | 50-74: High Risk | 75-100: Critical Risk
THRESHOLD_LOW_MAX=24
THRESHOLD_MED_MAX=49
THRESHOLD_HIGH_MAX=74
THRESHOLD_CRITICAL_MIN=75

# AI Integration Provider ("local", "openai", "gemini")
# "local" runs fully offline with deterministic heuristic rules & brand squatted detectors.
AI_PROVIDER=local
OPENAI_API_KEY=
GEMINI_API_KEY=

# Privacy Configuration
# If False, raw complete bodies are omitted from permanent DB persistence to protect privacy
RETAIN_FULL_BODY=False
